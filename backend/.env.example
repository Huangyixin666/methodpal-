# 本地开发模板。仅首次复制为 backend/.env；不要覆盖已有私有配置。
# 真实 API key、SMTP 授权码不能提交 Git，也不能放进前端 VITE_* 配置。
METHODPAL_ENV=development
METHODPAL_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
METHODPAL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
METHODPAL_AGENT_BACKEND=langgraph
METHODPAL_JOB_WORKER=1
METHODPAL_REGISTRATION=open
METHODPAL_CAPTCHA_REQUIRED=0
METHODPAL_EMAIL_REQUIRED=0

# 留空可运行本地数据分析；聊天只返回帮助降级，不调用真实 LLM。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_VERIFY_SSL=true
DEEPSEEK_TRUST_ENV=false

# 不设置则使用 backend/storage/。生产数据应与发布源码分离。
# METHODPAL_DATA_ROOT=/var/lib/methodpal
# METHODPAL_DATABASE_PATH=/var/lib/methodpal/methodpal.sqlite3
# METHODPAL_CHART_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc

# 邮箱注册/绑定/找回需要真实 SMTP。配置后按需要设置 EMAIL_REQUIRED=1。
# METHODPAL_SMTP_HOST=smtp.example.org
# METHODPAL_SMTP_PORT=465
# METHODPAL_SMTP_TLS=ssl
# METHODPAL_SMTP_USER=sender@example.org
# METHODPAL_SMTP_PASSWORD=
# METHODPAL_SMTP_FROM=sender@example.org
# METHODPAL_VERIFICATION_SECRET=
