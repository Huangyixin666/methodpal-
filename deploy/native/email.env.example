# Keep the filled file PRIVATE. Do not commit or paste the authorization code into chat.
# Save on the server as /etc/methodpal/email.env (root:methodpal, mode 640).
METHODPAL_SMTP_HOST=smtp.example.org
METHODPAL_SMTP_PORT=465
METHODPAL_SMTP_TLS=ssl
METHODPAL_SMTP_USER=sender@example.org
# Set the real mailbox authorization code only in the private server file.
METHODPAL_SMTP_PASSWORD=
METHODPAL_SMTP_FROM=sender@example.org
METHODPAL_EMAIL_REQUIRED=1
