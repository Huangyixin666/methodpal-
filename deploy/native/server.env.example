METHODPAL_ENV=production
METHODPAL_ORIGINS=https://139.199.4.56
METHODPAL_ALLOWED_HOSTS=139.199.4.56,127.0.0.1,localhost
METHODPAL_DATA_ROOT=/var/lib/methodpal
METHODPAL_REGISTRATION=open
METHODPAL_CAPTCHA_REQUIRED=1
METHODPAL_ACCOUNT_QUOTA_BYTES=524288000
METHODPAL_ACCOUNT_PROJECT_LIMIT=50
METHODPAL_ACCOUNT_DATASET_LIMIT=100
# Email registration is required automatically once SMTP is configured.
# Override METHODPAL_EMAIL_REQUIRED=1 to require it even before configuration (registration will be blocked).
DEEPSEEK_VERIFY_SSL=true
DEEPSEEK_TRUST_ENV=false
