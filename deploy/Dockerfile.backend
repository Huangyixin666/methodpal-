FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 fonts-dejavu-core fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-deploy.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/app /app/app
COPY backend/main.py /app/main.py
COPY backend/scripts /app/scripts
RUN useradd --create-home --uid 10001 methodpal && mkdir -p /data && chown methodpal:methodpal /data
USER methodpal
ENV METHODPAL_DATA_ROOT=/data PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/api/health')"
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--limit-concurrency", "32", "--timeout-keep-alive", "5", "--no-proxy-headers"]
