# Default: frontend calls /api and Vite proxies it to the local FastAPI backend.
VITE_API_BASE_URL=/api
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
VITE_DEV_HOST=0.0.0.0
VITE_DEV_PORT=5173

# For Cloudflare Tunnel / ngrok sharing, put the generated public hostname here, without https://.
# Example: VITE_ALLOWED_HOSTS=abc-def-ghi.trycloudflare.com
# Temporary quick demo only: VITE_ALLOWED_HOSTS=true
VITE_ALLOWED_HOSTS=
